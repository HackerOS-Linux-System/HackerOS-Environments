using <0.4>

include <launcher>
include <workspaces>

!!! HackerScript nie ma (i nie powinien miec) wlasnej skladni na
!!! deklaratywny UI - `slint::slint!{ ... }` to proc-makro Rusta,
!!! wiec ten JEDEN blok musi byc `native {Rust}` (patrz docs/SYNTAX.md
!!! w repo HackerScript, sekcja "native {Silnik}"). Zaleznosci
!!! crates.io uzywane WEWNATRZ bloku nizej deklaruje sie zwyklym
!!! `get <crates:...>` tutaj, na poczatku pliku - `virus build`
!!! skanuje kazdy plik .hcs pod katem takich deklaracji, wiec nic
!!! wiecej nie trzeba dopisywac (parytet z hackerc/cmd/hlib.hcs w
!!! repo HackerScript, ktory robi dokladnie to samo dla `native {Rust}`).
get <crates:slint::1.18>
get <crates:chrono::0.4>

!!! Buduje okno powloki, wypelnia je danymi z `apps`/`tabs` (czysty
!!! HackerScript, patrz launcher.hcs/workspaces.hcs) i odpala petle
!!! zdarzen Slint - blokuje az do zamkniecia okna. `apps`/`tabs` ponizej
!!! sa zwyklymi parametrami TEJ funkcji .hcs, wiec w miejscu bloku
!!! `native {Rust}` sa juz zywymi bindingami Rusta (`Vec<LauncherApp>`
!!! / `Vec<WorkspaceTab>`) o tych samych nazwach - blok uzywa ich
!!! wprost, bez zadnego FFI/serializacji (dokladnie mechanizm opisany
!!! w komentarzu nad `native {Rust}` w hackerc/cmd/hlib.hcs).
fun run_shell(apps: List<LauncherApp>, tabs: List<WorkspaceTab>) [
    native {Rust} [
        use slint::{Model, ModelRc, VecModel, Timer, TimerMode};
        use std::thread;
        use chrono::Local;

        slint::slint! {
            import { HorizontalBox } from "std-widgets.slint";

            export struct LauncherAppUi {
                label: string,
                index: int,
            }

            export struct WorkspaceUi {
                label: string,
                index: int,
            }

            export component ShellWindow inherits Window {
                title: "HackerOS // slint-shell";
                background: #05070a;
                default-font-family: "monospace";
                width: 760px;
                height: 44px;
                no-frame: true;
                always-on-top: true;

                in-out property <string> clock-text: "--:--:--";
                in-out property <int> active-workspace: 1;
                in property <[LauncherAppUi]> apps: [];
                in property <[WorkspaceUi]> workspaces: [];

                callback launch-app(int);
                callback switch-workspace(int);

                Rectangle {
                    background: #05070a;
                    border-width: 1px;
                    border-color: #39ff14;

                    HorizontalBox {
                        padding: 6px;
                        spacing: 14px;

                        Text {
                            text: "HackerOS";
                            color: #39ff14;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        Rectangle { width: 1px; background: #145214; }

                        HorizontalLayout {
                            spacing: 4px;
                            for ws in workspaces : Rectangle {
                                width: 26px;
                                height: 26px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #39ff14;
                                background: ws.index == active-workspace ? #14401a : #05070a;

                                Text {
                                    text: ws.label;
                                    color: #39ff14;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => {
                                        active-workspace = ws.index;
                                        switch-workspace(ws.index);
                                    }
                                }
                            }
                        }

                        Rectangle { width: 1px; background: #145214; }

                        HorizontalLayout {
                            spacing: 6px;
                            for app in apps : Rectangle {
                                border-width: 1px;
                                border-color: #2fa316;
                                border-radius: 4px;

                                HorizontalBox {
                                    padding: 4px;
                                    Text {
                                        text: app.label;
                                        color: #a6ffb0;
                                        vertical-alignment: center;
                                    }
                                }

                                TouchArea {
                                    clicked => { launch-app(app.index); }
                                }
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        Text {
                            text: clock-text;
                            color: #39ff14;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        let launcher_rows: Vec<LauncherAppUi> = apps
            .iter()
            .enumerate()
            .map(|(i, a)| LauncherAppUi {
                label: a.label.clone().into(),
                index: i as i32,
            })
            .collect();

        let workspace_rows: Vec<WorkspaceUi> = tabs
            .iter()
            .map(|t| WorkspaceUi {
                label: t.label.clone().into(),
                index: t.index as i32,
            })
            .collect();

        let ui = ShellWindow::new().expect("nie udalo sie utworzyc okna Slint (slint-shell) - sprawdz czy dziala serwer Wayland/labwc");

        ui.set_apps(ModelRc::new(VecModel::from(launcher_rows)));
        ui.set_workspaces(ModelRc::new(VecModel::from(workspace_rows)));
        ui.set_clock_text(Local::now().format("%H:%M:%S").to_string().into());

        let apps_for_launch = apps.clone();
        ui.on_launch_app(move |idx| {
            let idx = idx as usize;
            if let Some(app) = apps_for_launch.get(idx) {
                let app = app.clone();
                thread::spawn(move || {
                    run_launcher_app_blocking(app);
                });
            }
        });

        let tabs_for_switch = tabs.clone();
        ui.on_switch_workspace(move |idx| {
            if let Some(tab) = tabs_for_switch.iter().find(|t| t.index as i32 == idx) {
                note_workspace_switch_limitation(tab.clone());
            }
        });

        let ui_weak = ui.as_weak();
        let clock_timer = Timer::default();
        clock_timer.start(
            TimerMode::Repeated,
            std::time::Duration::from_secs(1),
            move || {
                if let Some(ui) = ui_weak.upgrade() {
                    ui.set_clock_text(Local::now().format("%H:%M:%S").to_string().into());
                }
            },
        );

        ui.run().expect("petla zdarzen slint-shell zakonczona bledem");
    ]
    end
]
