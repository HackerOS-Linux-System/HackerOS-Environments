using <0.4>

!!! Pojedyncza zakladka "pulpitu" pokazywana w powloce. Ten plik
!!! trzyma tylko dane/etykiety - samo realne przelaczanie pulpitow pod
!!! `labwc` NIE jest dzis podpiete, patrz `note_workspace_switch_limitation`.
struct WorkspaceTab [
    label: Str,
    index: Int
]

fun default_workspaces() -> List<WorkspaceTab> [
    let tabs: List<WorkspaceTab> = []
    tabs.push(WorkspaceTab("1", 1))
    tabs.push(WorkspaceTab("2", 2))
    tabs.push(WorkspaceTab("3", 3))
    tabs.push(WorkspaceTab("4", 4))
    end tabs
]

!!! `labwc` obsluguje wiele pulpitow (sekcja `<desktops>` w
!!! `rc.xml`), ale przelacza je WYLACZNIE przez skonfigurowane skroty
!!! klawiszowe (akcja `GoToDesktop`) - nie ma dzis zadnego IPC/CLI do
!!! wywolania tego z zewnatrz (protokol/IPC labwc jest dopiero
!!! planowany upstream). Zeby nie udawac dzialania, ktorego nie ma,
!!! klikniecie zakladki w tej powloce na razie TYLKO loguje zamiar.
!!!
!!! Docelowe obejscie (do czasu realnego IPC) - symulowac
!!! skonfigurowany skrot klawiszowy przez `wtype`/`ydotool`
!!! (`run_command_inherit_ok("ydotool", [...])`, ten sam mechanizm co
!!! `run_launcher_app_blocking` w launcher.hcs); podmienic wtedy tylko
!!! cialo tej funkcji, reszta powloki (UI, model danych) jest juz na
!!! to gotowa.
fun note_workspace_switch_limitation(tab: WorkspaceTab) [
    log("[slint-shell] klikniecie pulpitu", tab.label, "- realne przelaczanie pod labwc jeszcze niepodpiete (patrz komentarz w workspaces.hcs)")
    end
]
