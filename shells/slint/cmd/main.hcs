using <0.4>

!!! Powloka (shell) HackerOS: pasek uruchamiany jako zwykly klient
!!! Wayland pod kompozytorem `labwc`. Wiekszosc logiki (konfiguracja
!!! launchera w launcher.hcs, lista pulpitow w workspaces.hcs,
!!! uruchamianie procesow) to czysty HackerScript - jedyny fragment,
!!! ktory MUSI byc Rustem, to samo UI Slint w ui.hcs (patrz komentarz
!!! tam), bo `slint::slint!{}` to proc-makro dostepne tylko w Ruscie.

include <launcher>
include <workspaces>
include <ui>

fun log_startup_banner(apps: List<LauncherApp>, tabs: List<WorkspaceTab>) [
    log("=== HackerOS slint-shell ===")
    log("kompozytor docelowy: labwc (Wayland/wlroots)")
    log("wpisy launchera:", apps.len())
    for app in apps [
        log(" -", describe_launcher_app(app))
    ]
    log("pulpity:", tabs.len())
    end
]

fun main() [
    let apps = default_launcher_apps()
    let tabs = default_workspaces()
    log_startup_banner(apps.clone(), tabs.clone())
    run_shell(apps, tabs)
    end
]
