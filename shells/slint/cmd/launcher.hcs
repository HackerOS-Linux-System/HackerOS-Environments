using <0.4>

get <std:process> import <run_command_inherit_ok>
get <std:string> import <str_join>

!!! Pojedynczy wpis w panelu szybkiego uruchamiania powloki.
struct LauncherApp [
    label: Str,
    program: Str,
    args: List<Str>
]

!!! Domyslna lista aplikacji pokazywanych w launcherze powloki.
!!! Proof-of-concept - w normalnym uzyciu wczytalbys to z pliku
!!! konfiguracyjnego uzytkownika (patrz TODO na dole pliku) zamiast
!!! trzymac na sztywno w kodzie.
fun default_launcher_apps() -> List<LauncherApp> [
    let apps: List<LauncherApp> = []
    apps.push(LauncherApp("Terminal", "foot", []))
    apps.push(LauncherApp("Przegladarka", "firefox", []))
    apps.push(LauncherApp("Pliki", "pcmanfm", []))
    apps.push(LauncherApp("Blokada ekranu", "swaylock", ["-f"]))
    end apps
]

!!! Blokujaca wersja odpalenia aplikacji (czeka na zakonczenie
!!! procesu) - czysty HackerScript, bez zadnego UI. Warstwa UI
!!! (`ui.hcs`) wola ja na osobnym watku `std::thread`, zeby klikniecie
!!! w launcherze nie zamrazalo petli zdarzen Slint na czas dzialania
!!! uruchomionej aplikacji.
fun run_launcher_app_blocking(app: LauncherApp) -> Bool [
    end run_command_inherit_ok(app.program.clone(), app.args.clone())
]

!!! Etykieta do logu/debugowania (poza samym UI Slint, gdzie etykieta
!!! przycisku idzie bezposrednio z `app.label`).
fun describe_launcher_app(app: LauncherApp) -> Str [
    end app.label + " -> " + app.program + " " + str_join(app.args.clone(), " ")
]

