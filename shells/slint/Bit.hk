[package]
-> name => slint-shell
-> version => 0.1.0
-> using => 0.4
-> authors => HackerOS Team <hackeros068@gmail.com>
-> description => Pasek/powloka HackerOS: logika w HackerScript (.hcs), UI zbudowane na Slint przez blok native {Rust} (patrz cmd/ui.hcs). Domyslnie uruchamiana jako zwykly klient Wayland pod kompozytorem labwc.

[dependencies]
! Prawdziwe zaleznosci crates.io (slint, chrono) sa deklarowane
! bezposrednio w kodzie zrodlowym przez `get <crates:nazwa::wersja>`
! (patrz cmd/ui.hcs) - `virus build` skanuje kazdy odkryty plik .hcs
! i wykrywa je automatycznie, wiec ta sekcja zostaje pusta/opisowa
! (parytet z docs/VIRUS.md w repo HackerScript, sekcja "Manifest").
